---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoHeader from '../components/PhotoHeader.astro';
import CorrectedHeading from '../components/CorrectedHeading.astro';
import PhotoCutout from '../components/PhotoCutout.astro';
import WordScribble from '../components/WordScribble.astro';
import inTransit from '../assets/photos/in-transit.jpg';
---
<BaseLayout title="Courses" description="Courses by Indra Irwan. Built with experience, for those looking to be more clear and authentic. Coming soon.">
  <PhotoHeader src={inTransit} alt="Indra Irwan walking through a corridor, mid-motion." eyebrow="Courses">
    <CorrectedHeading
      variant="light"
      draft="Transform your life in 30 days"
      correction="Err&hellip;Not really"
      final="Practices for your writing,<br/>and for you."
    />
  </PhotoHeader>

  <section class="container courses-body">
    <p class="reveal courses-body__text">
      Learn to look at yourself, and what you make, more honestly. Lessons built from years of
      experience, explained like we're in the same room. Coming soon.
    </p>
    <p class="reveal courses-body__note">
      Want to know when it's ready? <a href="/contact">Tell me to hurry up.</a>
    </p>

    <div class="sticker-layer">
      <PhotoCutout
        file="cutout-optical"
        rotate={7}
        width="6.5rem"
        style="left:50rem; top:0;"
      />
      <WordScribble text="soon (really)" rotate={4} size="1.4rem" style="left:58rem; top:2rem;" />
    </div>
  </section>
</BaseLayout>

<style>
  .courses-body {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 4rem) clamp(6rem, 12vw, 9rem);
    max-width: 46rem;
  }
  .courses-body__text {
    font-size: 1.08rem;
    color: var(--color-text-soft);
    max-width: 54ch;
  }
  .courses-body__note {
    margin-top: 1.5rem;
    font-family: var(--font-accent);
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
  }
  .courses-body__note a {
    color: var(--color-mark);
  }
</style>
