---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoHeader from '../components/PhotoHeader.astro';
import CircleMark from '../components/CircleMark.astro';
import PhotoCutout from '../components/PhotoCutout.astro';
import WordScribble from '../components/WordScribble.astro';
import inTransit from '../assets/photos/in-transit.jpg';
---
<BaseLayout title="Courses" description="Courses by Indra Irwan — coming soon.">
  <PhotoHeader src={inTransit} alt="Indra Irwan walking through a corridor, mid-motion." eyebrow="Coming soon">
    <h1 class="reveal courses-heading">
      Courses <CircleMark><span class="scribble">coming soon</span></CircleMark>
    </h1>
  </PhotoHeader>

  <section class="container courses-body">
    <p class="reveal courses-body__text">
      I'm building a proper home for this — real lessons, on a real platform, not a waitlist form
      pretending to be content. It'll live here once it's ready.
    </p>
    <p class="reveal courses-body__note">
      Want to know when it's ready? <a href="/contact">Tell me to hurry up.</a>
    </p>

    <div class="sticker-layer">
      <PhotoCutout
        file="cutout-optical"
        rotate={7}
        width="6.5rem"
        style="left:50rem; top:0;"
      />
      <WordScribble text="soon (really)" rotate={4} size="1.4rem" style="left:58rem; top:2rem;" />
    </div>
  </section>
</BaseLayout>

<style>
  .courses-heading {
    font-size: clamp(2.2rem, 5.5vw, 3.8rem);
    color: var(--color-base);
  }
  .scribble {
    font-family: var(--font-hand);
    color: var(--color-mark);
    font-size: 0.55em;
    font-weight: 700;
    display: inline-block;
    transform: rotate(-3deg);
  }
  .courses-body {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 4rem) clamp(6rem, 12vw, 9rem);
    max-width: 46rem;
  }
  .courses-body__text {
    font-size: 1.08rem;
    color: var(--color-text-soft);
    max-width: 54ch;
  }
  .courses-body__note {
    margin-top: 1.5rem;
    font-family: var(--font-accent);
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
  }
  .courses-body__note a {
    color: var(--color-mark);
  }
</style>
