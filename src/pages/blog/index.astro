---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ParallaxImage from '../../components/ParallaxImage.astro';
import PhotoCutout from '../../components/PhotoCutout.astro';
import CaretMark from '../../components/CaretMark.astro';
import CorrectedHeading from '../../components/CorrectedHeading.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import PhotoSticker from '../../components/PhotoSticker.astro';
import HighlightMark from '../../components/HighlightMark.astro';
import nightMarket from '../../assets/photos/night-market.jpg';
import stickerTram from '../../assets/photos/sticker-tram.jpg';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const [latestPost, ...olderPosts] = posts;

function formatDate(d: Date) {
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
---
<BaseLayout title="Blog" description="Personal essays and opinions by Indra Irwan on culture, belief, identity, and the world as he sees it." image={nightMarket}>
  <section class="container blog-hero">
    <div class="blog-hero__copy">
      <Eyebrow text="Personal opinions" />
      <CorrectedHeading
        draft="Thought leadership content"
        correction="Not quite"
        final="Where the thinking goes<br/>beyond the job."
      />
      <p class="reveal-after-heading blog-hero__lead">
        Essays on the things I sit with, <HighlightMark>long and hard.</HighlightMark> On culture, belief, identity, and the world at
        large.
      </p>
    </div>
    <div class="blog-hero__photo reveal-scale">
      <ParallaxImage src={nightMarket} alt="Indra Irwan at a night market in Kuala Lumpur." aspect="4 / 5" priority={true} />
      <PhotoCutout file="cutout-new-dabao-b" rotate={-5} width="5rem" class="hero-sticker hero-sticker--a" />
      <PhotoCutout file="cutout-obj-sneakers" rotate={6} width="5.5rem" class="hero-sticker hero-sticker--b" />
    </div>
  </section>

  <CaretMark />

  {latestPost && (
    <section class="container latest-post">
      <Eyebrow text="Read my latest post" />
      <a href={`/blog/${latestPost.slug}`} class="latest-post__card reveal">
        <span class="latest-post__title">{latestPost.data.title}</span>
        {latestPost.data.description && <span class="latest-post__dek">{latestPost.data.description}</span>}
        <span class="latest-post__meta">
          <time datetime={latestPost.data.date.toISOString().slice(0, 10)}>{formatDate(latestPost.data.date)}</time>
          <span class="latest-post__arrow" aria-hidden="true">&rarr;</span>
        </span>
      </a>
    </section>
  )}

  <section class="container post-list-wrap">
    <ol class="post-list">
      {olderPosts.map((post) => (
        <li class="reveal">
          <a href={`/blog/${post.slug}`} class="post-item">
            <time class="post-item__date" datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
            <span class="post-item__title">{post.data.title}</span>
            {post.data.description && <span class="post-item__dek">{post.data.description}</span>}
          </a>
        </li>
      ))}
    </ol>

    <div class="sticker-layer">
      <PhotoSticker
        src={stickerTram}
        alt=""
        rotate={-6}
        width="8rem"
        aspect="4 / 5"
        objectPosition="55% 35%"
        style="right:-8.75rem; top:4%;"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .blog-hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(0.95rem, 2.35vw, 1.42rem);
  }
  .blog-hero__lead {
    margin-top: 1.5rem;
    font-size: 1.05rem;
    color: var(--color-text-soft);
    max-width: 46ch;
  }
  .blog-hero__photo { position: relative; width: 100%; border: 1px solid var(--color-line); }
  :global(.hero-sticker) {
    position: absolute;
  }
  :global(.hero-sticker--a) { left: -1rem; bottom: -1rem; }
  :global(.hero-sticker--b) { right: -1rem; bottom: -1rem; }

  .latest-post {
    padding-block: 0 clamp(1.5rem, 4vw, 2.5rem);
  }
  .latest-post__card {
    display: block;
    border: 1.5px solid var(--color-mark);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    text-decoration: none;
    color: var(--color-text);
    transition: background 0.2s var(--ease-editorial);
  }
  .latest-post__card:hover {
    background: rgba(var(--color-mark-rgb), 0.06);
  }
  .latest-post__title {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 3vw, 2rem);
  }
  .latest-post__dek {
    display: block;
    margin-top: 0.75rem;
    color: var(--color-text-soft);
    font-size: 1rem;
    max-width: 60ch;
  }
  .latest-post__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.5rem;
    font-family: var(--font-accent);
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    color: var(--color-mark);
  }
  .latest-post__arrow {
    font-family: var(--font-accent);
    transition: transform 0.25s var(--ease-editorial);
  }
  .latest-post__card:hover .latest-post__arrow {
    transform: translateX(6px);
  }

  .post-list-wrap {
    position: relative;
  }
  .post-list {
    list-style: none;
    margin: 0 0 5rem;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .post-item {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
    color: var(--color-text);
  }
  .post-item__date {
    font-family: var(--font-accent);
    font-size: 0.78rem;
    color: var(--color-mark);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-top: 0.2rem;
  }
  .post-item__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.2rem, 2.2vw, 1.55rem);
  }
  .post-item__dek {
    grid-column: 2 / 3;
    color: var(--color-text-soft);
    font-size: 0.95rem;
    max-width: 60ch;
  }
  .post-item:hover .post-item__title { color: var(--color-mark); }

  @media (max-width: 860px) {
    .blog-hero { grid-template-columns: 1fr; }
    .blog-hero__photo { order: -1; max-width: 20rem; margin-inline: auto; }
    :global(.hero-sticker--a) { left: -0.25rem; bottom: -0.5rem; width: 3.75rem !important; }
    :global(.hero-sticker--b) { right: -0.25rem; bottom: -0.5rem; width: 4rem !important; }
  }
  @media (max-width: 640px) {
    .post-item { grid-template-columns: 1fr; }
    .post-item__dek { grid-column: 1 / 2; }
  }
</style>
