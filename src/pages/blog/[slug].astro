---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import PhotoSticker from '../../components/PhotoSticker.astro';
import WordScribble from '../../components/WordScribble.astro';
import stickerBus from '../../assets/photos/sticker-bus.jpg';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(d: string) {
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
---
<BaseLayout title={post.data.title} description={post.data.description || undefined}>
  <article class="container post">
    <header class="post__header">
      <Eyebrow text="Unpaid opinions" />
      <h1 class="reveal">{post.data.title}</h1>
      <p class="post__meta reveal">
        <time datetime={post.data.date}>{formatDate(post.data.date)}</time> &middot; Indra Irwan
      </p>
      {post.data.description && <p class="post__dek reveal">{post.data.description}</p>}

      <div class="sticker-layer">
        <PhotoSticker
          src={stickerBus}
          alt=""
          rotate={-7}
          width="7rem"
          aspect="4 / 5"
          objectPosition="55% 30%"
          style="right:-9rem; top:0;"
        />
        <WordScribble text="actually—" rotate={-3} size="1.3rem" style="right:-10rem; top:9rem;" />
      </div>
    </header>

    <div class="post__body reveal">
      <Content />
    </div>

    <footer class="post__footer reveal">
      <a href="/blog" class="btn">&larr; Back to all posts</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 50rem;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(4rem, 8vw, 6rem);
  }
  .post__header {
    position: relative;
  }
  .post__header h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    margin-top: 0.5rem;
  }
  .post__meta {
    font-family: var(--font-accent);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-soft);
    margin-top: 1rem;
  }
  .post__dek {
    font-size: 1.15rem;
    color: var(--color-text-soft);
    margin-top: 1rem;
    max-width: 50ch;
  }
  .post__body {
    margin-top: 2.5rem;
    font-size: clamp(1.05rem, 0.95rem + 0.35vw, 1.25rem);
  }
  .post__body :global(h2) {
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .post__body :global(p) { margin-bottom: 1.4em; }
  .post__body :global(a) {
    color: var(--color-mark);
    text-decoration-thickness: 1px;
  }
  .post__body :global(blockquote p) { margin-bottom: 0.4em; }
  .post__footer {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-line);
  }
</style>
