---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaretMark from '../components/CaretMark.astro';
import ParallaxImage from '../components/ParallaxImage.astro';
import CorrectedHeading from '../components/CorrectedHeading.astro';
import Eyebrow from '../components/Eyebrow.astro';
import PhotoCutout from '../components/PhotoCutout.astro';
import Scribble from '../components/Scribble.astro';
import HighlightMark from '../components/HighlightMark.astro';
import UnderlineMark from '../components/UnderlineMark.astro';
import neonPhoto from '../assets/photos/neon.jpg';

const categories = [
  {
    n: '01',
    title: 'Copywriting',
    body: "Whether it's a 30-second script or social content hooks, I write copy, scripts, and campaign lines that feel right for the moment. Working in both English and Bahasa Malaysia, I go beyond writing, translating, editing, and proofreading. I figure out what you should really be saying, so it actually ",
    bodyMark: 'talks to your audience and not just at them.',
    tags: ['Campaign & Traditional Copy', 'Social Media Copy', 'English & BM Adaptation', 'Edit & Proofread'],
    cta: 'Send Me a Brief',
  },
  {
    n: '02',
    title: 'Creative Strategy',
    body: "Everything worth acting on starts with a strategy. I help brands figure out what to say and where, including campaign ideation, positioning, and digital and content strategy. When that thinking needs to reach a whole team, that's where my ",
    bodyMark: 'creative leadership comes in.',
    tags: ['Brand Strategy', 'Campaign Ideation', 'Creative Direction', 'Workshop Facilitation'],
    cta: "Let's Start Planning",
  },
  {
    n: '03',
    title: 'Wellness',
    body: "When you or your team needs clarity, I run mindfulness sessions built around it. It's the same kind of attention I bring to a brief, where together we sit with intention until ",
    bodyMark: "what's underneath rises to the surface.",
    tags: ['Mindfulness & Reflection', '1:1 Sessions', 'Group Workshops', 'In-Person & Virtual'],
    cta: 'Come Breathe With Me',
  },
];
---
<BaseLayout title="Services" description="Your one-man team for copywriting, creative strategy, and wellness services." image={neonPhoto}>
  <section class="container services-hero">
    <div class="services-hero__copy">
      <Eyebrow text="What I actually do" />
      <CorrectedHeading
        draft="Full-service creative solutions provider."
        correction="In plain terms —"
        final="Writing, Solving Problems,<br/>and Helping You Just Breathe"
      />
      <p class="reveal-after-heading services-hero__lead">
        Different problems need different tools. Sometimes that's a headline, or a strategy deck. Other
        times, you just need a guided quiet time. I can help with <HighlightMark>any one, or all of them.</HighlightMark>
      </p>
    </div>
    <div class="services-hero__photo reveal-scale">
      <ParallaxImage src={neonPhoto} alt="Indra Irwan lit by a neon sign at night." aspect="4 / 5" priority={true} />
      <PhotoCutout file="cutout-walking" rotate={-5} width="5rem" class="hero-sticker hero-sticker--a" />
      <PhotoCutout file="cutout-obj-clapperboard" rotate={10} width="4.5rem" class="hero-sticker hero-sticker--b" />
    </div>
  </section>

  <CaretMark />

  <section class="container categories">
    {categories.map((c) => (
      <div class="category reveal">
        <span class="category__n">{c.n}</span>
        <h2 class="category__title">{c.title}</h2>
        <p class="category__body">{c.body}<UnderlineMark>{c.bodyMark}</UnderlineMark></p>
        <ul class="category__tags">
          {c.tags.map((t) => <li>{t}</li>)}
        </ul>
        <a href={`/contact?topic=${encodeURIComponent(c.title)}`} class="btn btn-primary category__cta">
          {c.cta}
        </a>
      </div>
    ))}
  </section>

  <section class="container services-cta reveal">
    <div class="services-cta__block">
      <p class="services-cta__lead">Want the full picture?</p>
      <p class="services-cta__body">Case studies, career timeline, the works.</p>
      <a href="/indra-irwan-profile.pdf" class="btn">Download my profile</a>
    </div>

    <div class="sticker-layer">
      <PhotoCutout
        file="cutout-garst"
        rotate={-6}
        width="11rem"
        style="right:8%; top:8%;"
      />
      <PhotoCutout
        file="cutout-obj-keyboard"
        rotate={5}
        width="8rem"
        style="left:-8.75rem; bottom:0;"
      />
      <Scribble kind="arrow" rotate={162} size="2.75rem" style="left:24%; top:51%;" />
    </div>
  </section>
</BaseLayout>

<style>
  .services-hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(0.95rem, 2.35vw, 1.42rem);
  }
  .services-hero__lead {
    margin-top: 1.5rem;
    font-size: 1.05rem;
    color: var(--color-text-soft);
    max-width: 46ch;
  }
  .services-hero__photo { position: relative; width: 100%; border: 1px solid var(--color-line); }
  :global(.hero-sticker) {
    position: absolute;
  }
  :global(.hero-sticker--a) { left: -1rem; bottom: -1rem; z-index: 2; }
  :global(.hero-sticker--b) { left: 2.75rem; bottom: 1.25rem; z-index: 1; }

  .categories {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  .category {
    display: flex;
    flex-direction: column;
    border-top: 3px solid var(--color-mark);
    padding-top: 1.5rem;
  }
  .category__n {
    font-family: var(--font-accent);
    color: var(--color-mark);
    font-size: 0.85rem;
  }
  .category__title {
    font-size: clamp(1.25rem, 2.1vw, 1.55rem);
    margin-block: 0.6rem 0.9rem;
    max-width: 18ch;
  }
  .category__body {
    color: var(--color-text-soft);
    font-size: 0.98rem;
    margin-bottom: 1.25rem;
  }
  .category__tags {
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .category__tags li {
    font-family: var(--font-accent);
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-text-soft);
    border: 1px solid var(--color-line);
    padding: 0.35em 0.6em;
  }
  .category__cta {
    align-self: flex-start;
    margin-top: auto;
    font-size: 0.75rem;
    padding: 0.75em 1.1em;
  }

  .services-cta {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 4rem) clamp(4rem, 8vw, 6rem);
    border-top: 1px solid var(--color-line);
  }
  .services-cta__lead {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    margin: 0 0 0.5rem;
  }
  .services-cta__body {
    color: var(--color-text-soft);
    margin: 0 0 1.25rem;
  }

  @media (max-width: 860px) {
    .services-hero { grid-template-columns: 1fr; }
    .services-hero__photo { order: -1; max-width: 20rem; margin-inline: auto; }
    :global(.hero-sticker--a) { left: -0.25rem; bottom: -0.5rem; width: 3.75rem !important; }
    :global(.hero-sticker--b) { left: 2.25rem; bottom: 1rem; width: 3.25rem !important; }
    .categories { grid-template-columns: 1fr; }
  }
</style>
