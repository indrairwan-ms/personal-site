---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaretMark from '../components/CaretMark.astro';
import PhotoHeader from '../components/PhotoHeader.astro';
import CorrectedHeading from '../components/CorrectedHeading.astro';
import PhotoCutout from '../components/PhotoCutout.astro';
import Scribble from '../components/Scribble.astro';
import neonPhoto from '../assets/photos/neon.jpg';

const categories = [
  {
    n: '01',
    title: 'Copywriting',
    body: "Whether it's a 30-second script or social content hooks, I write copy, scripts, and campaign lines that feel right for the moment. Working in both English and Bahasa Malaysia, I go beyond writing, translating, editing, and proofreading. I figure out what you should really be saying, so it actually talks to your audience and not just at them.",
    tags: ['Campaign & Traditional Copy', 'Social Media Copy', 'English & BM Adaptation', 'Edit & Proofread'],
  },
  {
    n: '02',
    title: 'Creative Strategy',
    body: "Everything worth acting on starts with a strategy. I help brands figure out what to say and where, including campaign ideation, positioning, and digital and content strategy. When that thinking needs to reach a whole team, that's where my creative leadership comes in.",
    tags: ['Brand Strategy', 'Campaign Ideation', 'Creative Direction', 'Workshop Facilitation'],
  },
  {
    n: '03',
    title: 'Wellness',
    body: "When you or your team needs clarity, I run mindfulness sessions built around it. It's the same kind of attention I bring to a brief, where together we sit with intention until what's underneath rises to the surface.",
    tags: ['Mindfulness & Reflection', '1:1 Sessions', 'Group Workshops', 'In-Person & Virtual'],
  },
];
---
<BaseLayout title="Services" description="Your one-man team for copywriting, creative strategy, and wellness services.">
  <PhotoHeader src={neonPhoto} alt="Indra Irwan lit by a neon sign at night." eyebrow="What I actually do">
    <CorrectedHeading
      variant="light"
      draft="Full-service creative solutions provider."
      correction="In plain terms —"
      final="Writing, Solving Problems,<br/>and Helping You Just Breathe"
    />
    <p slot="lead" class="photo-header__lead">
      Different problems need different tools. Sometimes that's a headline, or a strategy deck. Other
      times, you just need a guided quiet time. I can help with any one, or all of them.
    </p>
  </PhotoHeader>

  <CaretMark />

  <section class="container categories">
    {categories.map((c) => (
      <div class="category reveal">
        <span class="category__n">{c.n}</span>
        <h2 class="category__title">{c.title}</h2>
        <p class="category__body">{c.body}</p>
        <ul class="category__tags">
          {c.tags.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    ))}
  </section>

  <section class="container services-cta reveal">
    <div class="services-cta__block">
      <p class="services-cta__lead">Let's Talk</p>
      <p class="services-cta__body">
        Have any questions? Contact me to get the answer you need.
      </p>
      <a href="/contact" class="btn btn-primary">Get in touch</a>
    </div>
    <div class="services-cta__block">
      <p class="services-cta__lead">Want the full picture?</p>
      <p class="services-cta__body">Case studies, career timeline, the works.</p>
      <a href="/indra-irwan-profile.pdf" class="btn">Download my profile</a>
    </div>

    <div class="sticker-layer">
      <PhotoCutout
        file="cutout-garst"
        rotate={-8}
        width="7.5rem"
        style="right:-8.25rem; top:0;"
      />
      <PhotoCutout
        file="cutout-obj-keyboard"
        rotate={5}
        width="8rem"
        style="left:-8.75rem; bottom:0;"
      />
      <Scribble kind="arrow" rotate={162} size="2.75rem" style="right:-4.5rem; bottom:1.5rem;" />
    </div>
  </section>
</BaseLayout>

<style>
  .categories {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  .category {
    border-top: 3px solid var(--color-mark);
    padding-top: 1.5rem;
  }
  .category__n {
    font-family: var(--font-accent);
    color: var(--color-mark);
    font-size: 0.85rem;
  }
  .category__title {
    font-size: clamp(1.25rem, 2.1vw, 1.55rem);
    margin-block: 0.6rem 0.9rem;
    max-width: 18ch;
  }
  .category__body {
    color: var(--color-text-soft);
    font-size: 0.98rem;
    margin-bottom: 1.25rem;
  }
  .category__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .category__tags li {
    font-family: var(--font-accent);
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-text-soft);
    border: 1px solid var(--color-line);
    padding: 0.35em 0.6em;
  }

  .services-cta {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: clamp(2.5rem, 6vw, 4rem) clamp(4rem, 8vw, 6rem);
    border-top: 1px solid var(--color-line);
  }
  .services-cta__lead {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    margin: 0 0 0.5rem;
  }
  .services-cta__body {
    color: var(--color-text-soft);
    margin: 0 0 1.25rem;
  }

  @media (max-width: 860px) {
    .categories { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .services-cta { grid-template-columns: 1fr; }
  }
</style>
