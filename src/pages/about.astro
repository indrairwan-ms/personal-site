---
import BaseLayout from '../layouts/BaseLayout.astro';
import ParallaxImage from '../components/ParallaxImage.astro';
import CaretMark from '../components/CaretMark.astro';
import CorrectedHeading from '../components/CorrectedHeading.astro';
import Eyebrow from '../components/Eyebrow.astro';
import LogoTicker from '../components/LogoTicker.astro';
import PhotoSticker from '../components/PhotoSticker.astro';
import PhotoCutout from '../components/PhotoCutout.astro';
import WordScribble from '../components/WordScribble.astro';
import HighlightMark from '../components/HighlightMark.astro';
import UnderlineMark from '../components/UnderlineMark.astro';
import portrait from '../assets/photos/about-portrait.jpg';
import stickerOptical from '../assets/photos/sticker-optical.jpg';
---
<BaseLayout title="About" description="15+ years in advertising across SEA, and what led to caring more about meaning than the marketplace.">
  <section class="container about-hero">
    <div class="about-hero__copy">
      <Eyebrow text="The Real Version" />
      <CorrectedHeading
        draft="Advertising Creative with 15+ years of experience."
        correction="Let me start over"
        final="I grew up in the city but lived a kampung lifestyle."
      />
      <p class="reveal-after-heading about-hero__lead">
        It&rsquo;s what taught me to consider the impact of every intention and action.
      </p>
    </div>
    <div class="about-hero__photo reveal-scale">
      <ParallaxImage src={portrait} alt="Portrait of Indra Irwan, leaning against a wall." aspect="4 / 5" priority={true} />
      <PhotoCutout file="cutout-cage" rotate={5} width="5rem" class="hero-sticker hero-sticker--a" />
      <PhotoCutout file="cutout-obj-camera" rotate={-7} width="5.5rem" class="hero-sticker hero-sticker--b" />
    </div>
  </section>

  <CaretMark />

  <section class="container about-body">
    <div class="about-body__text reveal">
      <p>
        <HighlightMark>For more than 15 years, I&rsquo;ve sought to integrate commerce and the human experience.</HighlightMark>
      </p>
      <p>
        In that time, I have crafted campaigns for global brands including <UnderlineMark>Apple, Grab, foodpanda,
        Nestle, and Toyota.</UnderlineMark> The kind of work that&rsquo;s taught me a campaign can do more than move
        product, if you let it. No matter the role I play, that&rsquo;s the perspective I bring. Be it
        consulting for a business, writing about the world we live in, or practicing mindfulness, the
        goal is always the same: to make something honest enough to actually mean something more.
      </p>
    </div>

    <blockquote class="about-quote reveal">
      From meaning, we find value.
    </blockquote>

    <div class="about-body__text reveal">
      <p>
        I can&rsquo;t perform a curated version of myself for very long. So I choose to just be who I
        am, and I hope I can help you or your brand do the same.
      </p>
    </div>

    <div class="sticker-layer">
      <PhotoSticker
        src={stickerOptical}
        alt=""
        rotate={8}
        width="8.5rem"
        aspect="4 / 5"
        objectPosition="50% 25%"
        style="right:-9.25rem; top:2%;"
      />
      <PhotoCutout
        file="cutout-obj-glasses"
        rotate={-6}
        width="7rem"
        style="right:-7.75rem; bottom:8%;"
      />
      <WordScribble text="writer" replace="thinker" rotate={-3} size="1.5rem" style="right:-8.5rem; top:36%;" />
    </div>
  </section>

  <CaretMark />

  <section class="clients reveal">
    <div class="container">
      <Eyebrow text="Who I've worked with" />
      <p class="clients__lead">
        15+ years, across agencies, in-house, and independently. This is what that looks like.
      </p>
    </div>
    <LogoTicker />
    <p class="clients__note container">This is not an exhaustive list.</p>
  </section>

  <section class="container about-cta-wrap">
    <div class="about-cta reveal">
      <p>Want the fifteen-year version, with the <HighlightMark>receipts?</HighlightMark></p>
      <a href="/indra-irwan-profile.pdf" class="btn btn-primary">Download my profile</a>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(0.95rem, 2.35vw, 1.42rem);
  }
  .about-hero__lead {
    margin-top: 1.5rem;
    font-size: 1.05rem;
    color: var(--color-text-soft);
    max-width: 42ch;
  }
  .about-hero__photo { position: relative; width: 100%; border: 1px solid var(--color-line); }
  :global(.hero-sticker) {
    position: absolute;
  }
  :global(.hero-sticker--a) { left: -1rem; bottom: -1rem; }
  :global(.hero-sticker--b) { right: -1rem; bottom: 2.5rem; }

  .about-body {
    position: relative;
    padding-block: clamp(1rem, 4vw, 2rem) clamp(4rem, 8vw, 6rem);
  }
  .about-body__text p { font-size: clamp(1.05rem, 0.85rem + 0.6vw, 1.4rem); }
  .about-quote {
    font-size: clamp(1.3rem, 2.5vw, 1.7rem);
    margin-block: 2.5rem;
  }
  .about-cta {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-line);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .about-cta p {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 0;
  }

  .about-cta-wrap {
    padding-block: 0 clamp(4rem, 8vw, 6rem);
  }

  .clients {
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  .clients__lead {
    color: var(--color-text-soft);
    font-size: 1.05rem;
    margin: 1.25rem 0 2rem;
  }
  .clients__note {
    margin: 1.25rem auto 0;
    font-family: var(--font-accent);
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--color-text-soft);
  }

  @media (max-width: 860px) {
    .about-hero { grid-template-columns: 1fr; }
    .about-hero__photo { order: -1; max-width: 20rem; margin-inline: auto; }
    :global(.hero-sticker--a) { left: -0.25rem; bottom: -0.5rem; width: 3.75rem !important; }
    :global(.hero-sticker--b) { right: -0.25rem; bottom: 1.5rem; width: 4rem !important; }
  }
</style>
