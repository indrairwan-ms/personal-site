---
import { getImage } from 'astro:assets';
import '@fontsource/syne/400.css';
import '@fontsource/syne/500.css';
import '@fontsource/syne/700.css';
import '@fontsource/syne/800.css';
import '@fontsource/inconsolata/400.css';
import '@fontsource/inconsolata/500.css';
import '@fontsource/inconsolata/600.css';
import '@fontsource/syne-mono/400.css';
import '@fontsource/caveat/600.css';
import '@fontsource/caveat/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import defaultOgImage from '../assets/photos/hero-stairwell.jpg';

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
  type?: 'website' | 'article';
  publishedTime?: Date;
}
const {
  title,
  description = 'Indra Irwan — creative strategist and copywriter. Clarity with a little heart.',
  image = defaultOgImage,
  type = 'website',
  publishedTime,
} = Astro.props;

const pageTitle = `${title} — I Am Indra`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const resolvedOgImage = await getImage({ src: image, width: 1200 });
const ogImageUrl = new URL(resolvedOgImage.src, Astro.site).toString();

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Indra Irwan',
  alternateName: 'I Am Indra',
  url: 'https://www.indrairwan.com',
  image: ogImageUrl,
  jobTitle: 'Advertising Creative, Writer & Wellness Guide',
  description: 'Indra Irwan — creative strategist and copywriter. Clarity with a little heart.',
  email: 'indrairwan.ms@gmail.com',
  telephone: '+60162933073',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-9TF69RW15J"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-9TF69RW15J');
    </script>

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="I Am Indra" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0, rootMargin: '0px 0px -10% 0px' }
      );
      document
        .querySelectorAll('.reveal, .reveal-scale, .caret-mark, [data-mark]')
        .forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
