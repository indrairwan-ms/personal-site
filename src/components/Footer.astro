---
const tickerText = 'INDRA IRWAN — ADVERTISING CREATIVE — WRITER — WELLNESS GUIDE — ';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      <span class="marquee__group">{tickerText.repeat(4)}</span>
      <span class="marquee__group">{tickerText.repeat(4)}</span>
    </div>
  </div>

  <div class="container site-footer__grid">
    <div>
      <p class="eyebrow">Open for notes</p>
      <p class="site-footer__lead">Got a brief, a mess, or a half-formed idea? Say the quiet part.</p>
      <a href="/contact" class="btn btn-primary" style="margin-top:1rem;">Get in touch</a>
    </div>
    <div class="site-footer__links">
      <div>
        <p class="site-footer__heading">Find your way</p>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/podcast">Podcast</a></li>
          <li><a href="/courses">Courses</a></li>
        </ul>
      </div>
      <div>
        <p class="site-footer__heading">Direct line</p>
        <ul>
          <li><a href="mailto:indrairwan.ms@gmail.com">indrairwan.ms@gmail.com</a></li>
          <li><a href="tel:+60162933073">+60 16-293 3073</a></li>
          <li><a href="/indra-irwan-profile.pdf">Download profile (PDF)</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {year} Indra Irwan. Typed, corrected, and sent anyway.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(4rem, 10vw, 7rem);
    border-top: 1px solid var(--color-line);
    background: var(--color-base);
  }
  .marquee {
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    padding-block: 0.85rem;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 12%, #000 88%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, #000 12%, #000 88%, transparent 100%);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 32s linear infinite;
  }
  .marquee__group {
    font-family: var(--font-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    white-space: nowrap;
    padding-right: 0;
  }
  @keyframes marquee-scroll {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track { animation: none; }
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(3rem, 7vw, 5rem);
  }
  .site-footer__lead {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    max-width: 22ch;
  }
  .site-footer__links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  .site-footer__heading {
    font-family: var(--font-accent);
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    color: var(--color-text-soft);
    margin: 0 0 0.9rem;
  }
  .site-footer__links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .site-footer__links a {
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .site-footer__links a:hover {
    border-bottom-color: var(--color-mark);
    color: var(--color-mark);
  }
  .site-footer__bottom {
    border-top: 1px solid var(--color-line);
    padding-block: 1.25rem;
    font-size: 0.8rem;
    color: var(--color-text-soft);
  }

  @media (max-width: 720px) {
    .site-footer__grid { grid-template-columns: 1fr; }
  }
</style>
