---
// A red underline beneath inline text — the lighter-touch sibling of CircleMark,
// for emphasis that shouldn't shout as loud as a full highlight.
// Uses native text-decoration (not an absolutely-positioned SVG) specifically so
// it keeps following the text correctly when it wraps across multiple lines.
---
<span class="underline-mark reveal-target" data-mark><slot /></span>

<style>
  .underline-mark {
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2.5px;
    text-underline-offset: 0.18em;
    transition: text-decoration-color 0.6s var(--ease-editorial);
  }
  .underline-mark.in-view {
    text-decoration-color: var(--color-mark);
  }
  @media (prefers-reduced-motion: reduce) {
    .underline-mark {
      text-decoration-color: var(--color-mark) !important;
      transition: none !important;
    }
  }
</style>
