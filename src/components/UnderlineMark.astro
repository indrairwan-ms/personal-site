---
// A hand-drawn red underline beneath inline text — the lighter-touch sibling of
// CircleMark, for emphasis that shouldn't shout as loud as a full circle.
---
<span class="underline-mark reveal-target" data-mark>
  <span class="underline-mark__text"><slot /></span>
  <svg class="underline-mark__svg" viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true">
    <path pathLength="1" d="M3,11 C45,3 90,16 120,9 C152,2 178,14 197,8" />
  </svg>
</span>

<style>
  .underline-mark {
    position: relative;
    display: inline-block;
  }
  .underline-mark__svg {
    position: absolute;
    left: -0.15em;
    right: -0.15em;
    bottom: -0.32em;
    width: calc(100% + 0.3em);
    height: 0.5em;
    pointer-events: none;
  }
  .underline-mark__svg path {
    fill: none;
    stroke: var(--color-mark);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.7s var(--ease-editorial);
  }
  .underline-mark.in-view .underline-mark__svg path {
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .underline-mark__svg path {
      stroke-dashoffset: 0 !important;
      transition: none !important;
    }
  }
</style>
