---
// A yellow highlighter swipe — the site's secondary accent, reserved for flagging
// information worth noticing (not a correction, just "read this bit").
---
<span class="highlight-mark reveal-target" data-mark><slot /></span>

<style>
  .highlight-mark {
    /* A highlighter only works with dark ink underneath it -- force it regardless
       of the surrounding text color, so this never ends up light-on-yellow. */
    color: var(--color-text) !important;
    /* Covers the full line box, ascenders and all -- a partial-height band left
       capital/ascender tips poking out above the yellow, which is invisible once
       the text underneath is forced dark against a dark (photo header) backdrop. */
    background-image: linear-gradient(var(--color-highlight), var(--color-highlight));
    background-repeat: no-repeat;
    background-position: 0 50%;
    background-size: 0% 100%;
    transition: background-size 0.6s var(--ease-editorial);
    padding-inline: 0.05em;
  }
  .highlight-mark.in-view {
    background-size: 100% 100%;
  }
  @media (prefers-reduced-motion: reduce) {
    .highlight-mark {
      background-size: 100% 100% !important;
      transition: none !important;
    }
  }
</style>
