---
// Small hand-drawn editorial doodles -- the site's answer to the reference
// moodboard's scattered stars/hearts, but drawn from the same red-pen
// correction-mark vocabulary already used elsewhere (checkmark, spark,
// arrow, question mark) rather than generic decorative icons.
// The "arrow" kind's native direction (rotate=0) points up-and-right;
// use `rotate` to aim it at an actual nearby target, not decoratively.
interface Props {
  kind?: 'check' | 'squiggle' | 'squiggle-long' | 'spark' | 'arrow' | 'question' | 'circle' | 'star';
  size?: string;
  rotate?: number;
  style?: string;
  class?: string;
}
const {
  kind = 'check',
  size = '2.5rem',
  rotate = 0,
  style: extraStyle = '',
  class: className = '',
} = Astro.props;

const paths: Record<string, string> = {
  check: 'M4,13 C8,18 11,22 13,25 C19,15 27,6 36,3',
  squiggle: 'M3,14 C10,4 15,22 22,12 C28,4 33,18 39,10',
  'squiggle-long': 'M3,14 C10,4 15,22 22,12 C28,4 33,22 40,12 C46,4 51,22 58,12 C64,4 70,18 76,10',
  spark: 'M20,2 L23,16 L38,19 L23,22 L20,38 L17,22 L2,19 L17,16 Z',
  arrow: 'M3,20 C14,8 26,6 37,9 M28,4 L37,9 L33,19',
  question: 'M8,10 C8,3 15,1 20,4 C25,7 25,14 19,17 C16,19 16,21 16,24 M16,31 L16.5,31',
  circle: 'M20,4 C31,3 37,11 36,20 C35,30 26,36 16,35 C6,34 2,25 4,16 C6,7 13,4 20,4 Z',
  star: 'M20,2 L25,15 L39,16 L28,25 L32,39 L20,31 L8,39 L12,25 L1,16 L15,15 Z',
};
const viewBoxes: Record<string, string> = {
  check: '0 0 40 28',
  squiggle: '0 0 42 26',
  'squiggle-long': '0 0 80 26',
  spark: '0 0 40 40',
  arrow: '0 0 40 24',
  question: '0 0 32 34',
  circle: '0 0 40 40',
  star: '0 0 40 40',
};
---
<span
  class={`scribble-mark reveal-target ${className}`}
  style={`--size: ${size}; --rotate: ${rotate}deg; ${extraStyle}`}
  data-mark
  aria-hidden="true"
>
  <svg viewBox={viewBoxes[kind]} class="scribble-mark__svg">
    <path pathLength="1" d={paths[kind]} />
  </svg>
</span>

<style>
  .scribble-mark {
    display: inline-block;
    width: var(--size);
    height: var(--size);
    transform: rotate(var(--rotate));
  }
  .scribble-mark__svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .scribble-mark__svg path {
    fill: none;
    stroke: var(--color-mark);
    stroke-width: 2.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.7s var(--ease-editorial);
  }
  .scribble-mark.in-view .scribble-mark__svg path {
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .scribble-mark__svg path {
      stroke-dashoffset: 0 !important;
      transition: none !important;
    }
  }
</style>
