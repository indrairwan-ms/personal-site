---
const navItems = [
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/blog', label: 'Blog' },
  { href: '/podcast', label: 'Podcast' },
  { href: '/courses', label: 'Courses' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container site-header__row">
    <a href="/" class="site-header__mark" aria-label="I Am Indra — home">
      <img src="/favicon.png" alt="" class="site-header__logo" width="536" height="540" />
      I Am Indra<span class="site-header__caret">^</span>
    </a>
    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="site-nav">
      <span>Menu</span>
    </button>
    <nav class="site-nav" id="site-nav">
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-base);
    border-bottom: 1px solid var(--color-line);
  }
  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.1rem;
  }
  .site-header__mark {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    text-decoration: none;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }
  .site-header__logo {
    height: 1.5rem;
    width: auto;
  }
  .site-header__caret {
    color: var(--color-mark);
    margin-left: 0.15em;
  }
  .nav-toggle {
    display: none;
    background: none;
    border: 1.5px solid var(--color-text);
    padding: 0.5em 0.9em;
    font-family: var(--font-accent);
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    cursor: pointer;
  }
  .site-nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: clamp(1rem, 2vw, 2.1rem);
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    text-decoration: none;
    font-family: var(--font-accent);
    text-transform: uppercase;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    color: var(--color-text);
    position: relative;
    padding-bottom: 0.2em;
  }
  .site-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--color-mark);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease-editorial);
  }
  .site-nav a:hover::after,
  .site-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  @media (max-width: 900px) {
    .nav-toggle { display: inline-flex; }
    .site-nav {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      background: var(--color-base);
      border-bottom: 1px solid var(--color-line);
      padding: 1.25rem var(--gutter) 1.75rem;
    }
    .site-nav.is-open { display: block; }
    .site-nav ul {
      flex-direction: column;
      gap: 1.1rem;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(!!isOpen));
  });
</script>
