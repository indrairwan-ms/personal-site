---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  aspect?: string;
  priority?: boolean;
}
const { src, alt, aspect = '4 / 5', priority = false } = Astro.props;
---
<div class="parallax" style={`aspect-ratio:${aspect};`} data-parallax>
  <Image
    src={src}
    alt={alt}
    class="parallax__img"
    widths={[480, 768, 1080, 1440]}
    sizes="(max-width: 720px) 100vw, 50vw"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
</div>

<style>
  .parallax {
    position: relative;
    overflow: hidden;
    width: 100%;
    background: var(--color-line);
  }
  .parallax__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.14) translate3d(0, 0, 0);
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    .parallax__img { transform: scale(1.14); }
  }
</style>

<script>
  const MAX_SHIFT = 26; // px — bounded so the 14% oversize scale never reveals an edge

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReduced) {
    const els = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
    let ticking = false;

    function update() {
      const vh = window.innerHeight;
      for (const el of els) {
        const rect = el.getBoundingClientRect();
        const elCenter = rect.top + rect.height / 2;
        const viewportCenter = vh / 2;
        // -1 (el above viewport) .. 0 (centered) .. 1 (el below viewport), clamped
        const progress = Math.max(-1, Math.min(1, (elCenter - viewportCenter) / (vh / 2 + rect.height / 2)));
        const shift = progress * MAX_SHIFT;
        const img = el.querySelector<HTMLElement>('.parallax__img');
        if (img) {
          img.style.transform = `scale(1.14) translate3d(0, ${shift.toFixed(1)}px, 0)`;
        }
      }
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>
