---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  eyebrow: string;
}
const { src, alt, eyebrow } = Astro.props;
---
<header class="photo-header">
  <Image
    src={src}
    alt={alt}
    class="photo-header__img"
    widths={[640, 1024, 1600, 2200]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="photo-header__scrim" aria-hidden="true"></div>
  <div class="container photo-header__content">
    <p class="eyebrow photo-header__eyebrow reveal">{eyebrow}</p>
    <slot />
    <slot name="lead" />
  </div>
</header>

<style>
  .photo-header {
    position: relative;
    min-height: clamp(20rem, 46vw, 30rem);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--color-text);
  }
  .photo-header__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo-header__scrim {
    position: absolute;
    inset: 0;
    /* Dark enough behind the text zone for the marks to read, without smothering
       most of the photo -- the highlight/text-color fixes now do most of the real
       legibility work, so this only needs to be a supporting layer, not the whole
       fix on its own. */
    background: linear-gradient(
      to top,
      rgba(22, 20, 18, 0.82) 0%,
      rgba(22, 20, 18, 0.7) 40%,
      rgba(22, 20, 18, 0.25) 68%,
      rgba(22, 20, 18, 0) 90%
    );
  }
  .photo-header__content {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    color: var(--color-base);
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.45);
  }
  .photo-header__eyebrow {
    color: var(--color-highlight);
  }
  .photo-header__eyebrow::before {
    background: var(--color-highlight);
  }
  .photo-header :global(.photo-header__lead) {
    margin-top: 1rem;
    max-width: 48ch;
    font-size: 1.05rem;
    color: rgba(247, 247, 244, 0.88);
  }
</style>
